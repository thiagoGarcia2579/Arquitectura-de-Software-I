{
  "realm": "inspecciones",
  "displayName": "Inspecciones de obra · Municipio",
  "enabled": true,
  "sslRequired": "none",
  "internationalizationEnabled": true,
  "supportedLocales": ["es", "en"],
  "defaultLocale": "es",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 2592000,
  "roles": {
    "realm": [
      { "name": "inspector", "description": "Carga actas sobre sus inspecciones" },
      { "name": "supervisor", "description": "Asigna inspecciones y revisa actas" },
      { "name": "administrativo", "description": "Consulta" }
    ]
  },
  "users": [
    { "id": "11111111-1111-1111-1111-111111111111", "username": "inspector1", "firstName": "Ana", "lastName": "Inspectora",
      "email": "inspector1@inspecciones.local", "emailVerified": true, "enabled": true,
      "credentials": [{ "type": "password", "value": "inspector123", "temporary": false }], "realmRoles": ["inspector"] },
    { "id": "22222222-2222-2222-2222-222222222222", "username": "inspector2", "firstName": "Beto", "lastName": "Inspector",
      "email": "inspector2@inspecciones.local", "emailVerified": true, "enabled": true,
      "credentials": [{ "type": "password", "value": "inspector123", "temporary": false }], "realmRoles": ["inspector"] },
    { "id": "33333333-3333-3333-3333-333333333333", "username": "supervisor1", "firstName": "Carla", "lastName": "Supervisora",
      "email": "supervisor1@inspecciones.local", "emailVerified": true, "enabled": true,
      "credentials": [{ "type": "password", "value": "supervisor123", "temporary": false }], "realmRoles": ["supervisor"] },
    { "id": "44444444-4444-4444-4444-444444444444", "username": "admin1", "firstName": "Diego", "lastName": "Administrativo",
      "email": "admin1@inspecciones.local", "emailVerified": true, "enabled": true,
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }], "realmRoles": ["administrativo"] }
  ],
  "clients": [
    {
      "clientId": "swagger-ui", "name": "Swagger UI (cliente público)", "enabled": true,
      "publicClient": true, "protocol": "openid-connect",
      "standardFlowEnabled": true, "implicitFlowEnabled": false, "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8080/oauth2-redirect.html"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [{ "name": "audiencia-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
        "config": { "included.custom.audience": "inspecciones-api", "access.token.claim": "true", "id.token.claim": "false" } }]
    },
    {
      "clientId": "inspecciones-web", "name": "Frontend web (cliente público)", "enabled": true,
      "publicClient": true, "protocol": "openid-connect",
      "standardFlowEnabled": true, "implicitFlowEnabled": false, "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/login/callback"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:5173/*" },
      "protocolMappers": [{ "name": "audiencia-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
        "config": { "included.custom.audience": "inspecciones-api", "access.token.claim": "true", "id.token.claim": "false" } }]
    },
    {
      "clientId": "inspecciones-cli", "name": "Scripts de verificación (SOLO desarrollo)", "enabled": true,
      "publicClient": true, "protocol": "openid-connect",
      "standardFlowEnabled": false, "directAccessGrantsEnabled": true,
      "protocolMappers": [{ "name": "audiencia-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
        "config": { "included.custom.audience": "inspecciones-api", "access.token.claim": "true", "id.token.claim": "false" } }]
    }
  ]
}