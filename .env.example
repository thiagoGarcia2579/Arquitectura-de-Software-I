# OPCIONAL. El sistema levanta sin este archivo (todo tiene valores por defecto de desarrollo).
# Copiá a ".env" solo si querés cambiar algo. ".env" está en .gitignore.

# --- Base de datos ---
 DB_NAME=inspecciones
 DB_USER=inspecciones
 DB_PASSWORD=cambiame-db-123

# --- Keycloak ---
# Contraseña del administrador de desarrollo. Cambiala fuera de un entorno local.
KC_ADMIN_PASSWORD=admin

# --- Simulador del sistema municipal (SOAP) ---
 MOCK_LATENCIA_MS=800
 MOCK_FALLO_PCT=30      # 0 = demo sin errores (por defecto); 30 = muestra los reintentos

# --- Capa anticorrupción ---
 SYNC_MAX_INTENTOS=20   # ~73 min de reintentos con backoff de tope 5 min