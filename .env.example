# Copiá este archivo a ".env" (cp .env.example .env) antes de levantar.
# .env está en .gitignore: NO se sube al repo.

# --- Base de datos ---
DB_NAME=inspecciones
DB_USER=inspecciones
DB_PASSWORD=cambiame-db-123

# --- Tokens (JWT) ---
# Secreto con el que auth firma y api/bff validan. En producción: largo, aleatorio y rotado.
JWT_SECRET=cambiame-por-un-secreto-largo-de-al-menos-32-caracteres
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7

# --- Simulador del sistema municipal (SOAP) ---
# Defectos del sistema "heredado": latencia y fallos intermitentes.
# Para una demo sin errores: MOCK_FALLO_PCT=0
MOCK_LATENCIA_MS=800
MOCK_FALLO_PCT=30
